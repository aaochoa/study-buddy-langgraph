# OPENROUTER KEY
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM SETTINGS
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,poolside/laguna-s-2.1:free,liquid/lfm-2.5-2.6b:free
LLM_EMBEDDINGS=nvidia/nemotron-3-embed-1b:free
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=100000

# CHROMADB CONNECTION VALUES (Optional: falls back to local disk persistence or in-memory)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
